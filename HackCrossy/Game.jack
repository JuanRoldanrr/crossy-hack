class Game {
    static int best;
    static int frameMs;
    static String sScore, sBest, sLevel, sOver, sAgain;

    field Array lanes;
    field Player player;
    field int score, level, tenCount, pos, roadRun, lastKey, pending, hopFrom;
    field boolean dead, hudDirty;

    function void initStatics() {
        let best = 0;
        let frameMs = 25;
        let sScore = "PUNTOS: ";
        let sBest = "RECORD: ";
        let sLevel = "NIVEL: ";
        let sOver = "GAME OVER";
        let sAgain = "ENTER: jugar de nuevo";
        return;
    }

    function void waitRelease() {
        while (~(Keyboard.keyPressed() = 0)) {
            do Rng.stir();
        }
        return;
    }

    function void waitEnter() {
        var int key;
        do Game.waitRelease();
        let key = 0;
        while (~(key = 128)) {
            do Rng.stir();
            let key = Keyboard.keyPressed();
        }
        do Game.waitRelease();
        return;
    }

    function void titleScreen() {
        do Screen.clearScreen();
        do Output.moveCursor(3, 26);
        do Output.printString("HACK-CROSSY");
        do Output.moveCursor(5, 14);
        do Output.printString("Cruza un mundo infinito sin ser atropellado");
        do Gfx.xorSprite(15, 88, Sprites.player());
        do Output.moveCursor(11, 18);
        do Output.printString("Flechas o WASD : saltar");
        do Output.moveCursor(12, 18);
        do Output.printString("Arboles        : bloquean el paso");
        do Output.moveCursor(13, 18);
        do Output.printString("Carros/camiones: game over");
        do Output.moveCursor(14, 18);
        do Output.printString("Cada carril nuevo = 1 punto");
        do Output.moveCursor(15, 18);
        do Output.printString("Cada 10 puntos sube el nivel");
        do Output.moveCursor(18, 24);
        do Output.printString("Presiona ENTER");
        do Game.waitEnter();
        return;
    }

    constructor Game new() {
        var int k;
        let score = 0;
        let level = 1;
        let tenCount = 0;
        let pos = 0;
        let roadRun = 0;
        let lastKey = 0;
        let pending = 0;
        let dead = false;
        let hudDirty = true;
        let lanes = Array.new(15);
        let k = 14;
        while (k > -1) {
            if (k > 10) {
                let lanes[k] = Lane.new(false, 1, true);
            } else {
                let lanes[k] = makeLane();
            }
            let k = k - 1;
        }
        let player = Player.new(15, 13);
        return this;
    }

    method Lane makeLane() {
        var boolean road;
        let road = Rng.bits(1) = 0;
        if (roadRun > 1) {
            let road = false;
        }
        if (road) {
            let roadRun = roadRun + 1;
        } else {
            let roadRun = 0;
        }
        return Lane.new(road, level, false);
    }

    method void redrawWorld() {
        var int k;
        var Lane ln;
        do Gfx.clearPlayfield();
        do player.forget();
        let k = 0;
        while (k < 15) {
            let ln = lanes[k];
            do ln.drawAll(k);
            let k = k + 1;
        }
        return;
    }

    method void drawHud() {
        do Output.moveCursor(0, 1);
        do Output.printString(sScore);
        do Output.printInt(score);
        do Output.moveCursor(0, 24);
        do Output.printString(sBest);
        do Output.printInt(best);
        do Output.moveCursor(0, 48);
        do Output.printString(sLevel);
        do Output.printInt(level);
        let hudDirty = false;
        return;
    }

    method boolean canEnter(int c, int l) {
        var boolean ok;
        var Lane ln;
        let ok = false;
        if ((c > -1) & (c < 32)) {
            if ((l > -1) & (l < 15)) {
                let ln = lanes[l];
                let ok = ~(ln.cellAt(c) = 5);
            }
        }
        return ok;
    }

    method void tryMove(int key) {
        var int c, l;
        var boolean valid;
        let c = player.getCol();
        let l = player.getLane();
        let valid = true;
        if ((key = 131) | (key = 87)) {
            let l = l - 1;
        } else {
            if ((key = 133) | (key = 83)) {
                let l = l + 1;
            } else {
                if ((key = 130) | (key = 65)) {
                    let c = c - 1;
                } else {
                    if ((key = 132) | (key = 68)) {
                        let c = c + 1;
                    } else {
                        let valid = false;
                    }
                }
            }
        }
        if (valid) {
            if (canEnter(c, l)) {
                let hopFrom = player.getLane();
                do player.startHop(c, l);
            }
        }
        return;
    }

    method void onLanding() {
        if (player.getLane() < hopFrom) {
            let pos = pos + 1;
            if (pos > score) {
                let score = pos;
                let hudDirty = true;
                let tenCount = tenCount + 1;
                if (tenCount = 10) {
                    let tenCount = 0;
                    let level = level + 1;
                }
                if (score > best) {
                    let best = score;
                }
            }
        }
        if (player.getLane() > hopFrom) {
            let pos = pos - 1;
        }
        if (player.getLane() < 7) {
            do scroll();
        }
        return;
    }

    method void scroll() {
        var int k;
        var Lane ln;
        let ln = lanes[14];
        do ln.dispose();
        let k = 14;
        while (k > 0) {
            let lanes[k] = lanes[k - 1];
            let k = k - 1;
        }
        let lanes[0] = makeLane();
        do player.setLane(player.getLane() + 1);
        do redrawWorld();
        return;
    }

    method boolean hitsCar() {
        var Lane ln;
        var int t;
        let ln = lanes[player.getLane()];
        let t = ln.cellAt(player.getCol());
        return (t > 0) & (t < 5);
    }

    method void updateLanes() {
        var int k;
        var Lane ln;
        let k = 0;
        while (k < 15) {
            let ln = lanes[k];
            do ln.update(k);
            let k = k + 1;
        }
        return;
    }

    method void run() {
        var int key;
        do Screen.clearScreen();
        do Gfx.drawHudFrame();
        do redrawWorld();
        do drawHud();
        do player.draw();
        while (~dead) {
            let key = Keyboard.keyPressed();
            if (~(key = 0)) {
                if (~(key = lastKey)) {
                    let pending = key;
                }
            }
            let lastKey = key;
            if (~player.isHopping()) {
                if (~(pending = 0)) {
                    do tryMove(pending);
                    let pending = 0;
                }
            }

            do player.erase();
            do updateLanes();
            if (player.isHopping()) {
                if (player.tick()) {
                    do onLanding();
                }
            }

            if (~player.isHopping()) {
                if (hitsCar()) {
                    let dead = true;
                }
            }

            do player.draw();
            if (hudDirty) {
                do drawHud();
            }
            do Sys.wait(frameMs);
        }
        do gameOver();
        return;
    }

    method void gameOver() {
        do drawHud();
        do Screen.setColor(true);
        do Screen.drawRectangle(126, 94, 385, 161);
        do Screen.setColor(false);
        do Screen.drawRectangle(128, 96, 383, 159);
        do Output.moveCursor(10, 27);
        do Output.printString(sOver);
        do Output.moveCursor(11, 26);
        do Output.printString(sScore);
        do Output.printInt(score);
        do Output.moveCursor(13, 21);
        do Output.printString(sAgain);
        do Game.waitEnter();
        return;
    }

    method void dispose() {
        var int k;
        var Lane ln;
        let k = 0;
        while (k < 15) {
            let ln = lanes[k];
            do ln.dispose();
            let k = k + 1;
        }
        do lanes.dispose();
        do player.dispose();
        do Memory.deAlloc(this);
        return;
    }
}
